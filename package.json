{
  "name": "nail-profit-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:down": "node scripts/migrate-down.mjs",
    "db:migrate:test": "drizzle-kit migrate --config drizzle.test.config.ts",
    "db:migrate:down:test": "node scripts/migrate-down.mjs --test",
    "db:seed:templates": "node scripts/seed-material-templates.mjs",
    "db:seed:templates:test": "node scripts/seed-material-templates.mjs --test",
    "icon": "node scripts/make-icon.mjs",
    "db:verify-rls": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f scripts/verify-rls.sql",
    "db:studio": "drizzle-kit studio",
    "ops:backup-drill": "./scripts/backup-restore-drill.sh",
    "pilot:ops": "node scripts/pilot.mjs",
    "ops:booking-maintenance": "node scripts/booking-maintenance.mjs",
    "ops:notifications": "node scripts/notifications.mjs",
    "ops:booking-metrics": "node scripts/booking-metrics.mjs",
    "ops:log-events": "node scripts/log-events.mjs",
    "ops:booking-latency": "node scripts/booking-latency.mjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "next": "16.3.0",
    "postgres": "3.4.9",
    "posthog-js": "^1.420.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svix": "^1.99.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
