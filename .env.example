DATABASE_URL=postgres://nail_profit_app:nail_profit_app@localhost:55432/nail_profit
MIGRATION_DATABASE_URL=postgres://nail_profit:nail_profit@localhost:55432/nail_profit
# Destructive integration/E2E suites are hard-blocked from using DATABASE_URL.
TEST_DATABASE_URL=postgres://nail_profit_app:nail_profit_app@localhost:55432/nail_profit_test
TEST_MIGRATION_DATABASE_URL=postgres://nail_profit:nail_profit@localhost:55432/nail_profit_test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Closed-pilot production deployments set this to true. An organization then
# needs an active pilot_enrollment before its workspace/API becomes available.
PILOT_ACCESS_ENFORCEMENT=false
# Required by `npm run pilot:ops -- report` to evaluate founder capacity.
PILOT_MONTHLY_SUPPORT_CAPACITY_MINUTES=600
# Phase 7 public routes remain dark until explicitly enabled per environment.
PUBLIC_BOOKING_ENABLED=false
# Section 7 rollback: false pauses delivery and keeps the outbox, so unpausing
# sends what accumulated instead of losing it.
NOTIFICATIONS_ENABLED=true
# Local development may keep `log`. Production pilot uses `resend`.
NOTIFICATION_PROVIDER=log
# Required only when NOTIFICATION_PROVIDER=resend. Verify the sender domain in
# Resend first; prefer a dedicated transactional subdomain.
RESEND_API_KEY=
RESEND_FROM=Nail Profit OS <booking@updates.example.com>
# Signing secret for POST /api/v1/webhooks/resend. Leave unset to disable the route.
RESEND_WEBHOOK_SECRET=
# The shared secret `npm run ops:notifications` authenticates the dispatch job
# with. Unset, the operator endpoint does not exist at all.
OPS_API_TOKEN=
# Chosen independently from NOTIFICATION_PROVIDER (email): local development
# may keep `log`. Production uses `smsmd`.
SMS_PROVIDER=log
# Required only when SMS_PROVIDER=smsmd. SMSMD_API_TOKEN is the X-Api-Token
# issued in Settings → API at app.sms.md; it needs the `messages:send` scope to
# send and `messages:read` for the delivery-status poll, which runs on the same
# cron as the dispatcher (sms.md's own callback carries nothing that identifies
# the tenant, see lib/smsmd-delivery-status.ts). SMSMD_SENDER_ID is the sender
# name registered with the Moldovan operators — it must already be approved
# there; a send with an unapproved name fails with 422.
SMSMD_API_TOKEN=
SMSMD_SENDER_ID=
# Signing secret for POST /api/v1/webhooks/paddle. Leave unset to disable the
# route. This is the notification destination's endpoint_secret_key (pdl_ntfset_…),
# shown once when the destination is created and not retrievable afterwards.
# Sandbox and live destinations have different secrets — use the one matching
# the account this deployment points at.
PADDLE_WEBHOOK_SECRET=
# Rejects webhook callers that are not in Paddle's published IP allowlist
# (https://api.paddle.com/ips, fetched at runtime — never hard-code it). Off by
# default: the signature check is the hard gate, and a laptop testing against a
# tunnel is not on Paddle's addresses. Set true on a real deployment. See
# env.ts's isPaddleWebhookIpAllowlistEnabled and lib/paddle-ips.ts.
PADDLE_WEBHOOK_IP_ALLOWLIST=false
# Server-side Paddle API key (Paddle > Developer tools > Authentication):
# pdl_sdbx_… in sandbox, pdl_live_… in live. Secret — never ships in the browser
# bundle, unlike NEXT_PUBLIC_PADDLE_CLIENT_TOKEN below. Base host follows
# NEXT_PUBLIC_PADDLE_ENVIRONMENT (sandbox-api / api.paddle.com). Used now to read a
# subscription's manage/cancel link (the webhooks omit management_urls); later for
# upgrades and cancellations. Unset → the "manage subscription" link is hidden.
PADDLE_API_KEY=
# Signing secret for POST /api/v1/webhooks/lemon-squeezy. Leave unset to disable the route.
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Independent of PILOT_ACCESS_ENFORCEMENT: an organization then needs an
# active organization_subscription (from Paddle or Lemon Squeezy) before its
# workspace/API becomes available. Pilot studios are unaffected either way —
# see env.ts's isSubscriptionAccessEnforced.
SUBSCRIPTION_ACCESS_ENFORCEMENT=false
# Placeholders for the "start subscription" button on /app/settings. Public
# values (safe in the browser bundle), not secrets. Leave unset — the button
# stays hidden — until a real product + price exist in the target account.
# Client-side token: live_… for a live account, test_… for sandbox. For Paddle
# Retain, Paddle.Initialize() also needs pwCustomer: { id: 'ctm_…' } — the
# signed-in customer's Paddle customer id (not the internal org id, not an email).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# One price id today; the approved plan (Solo/Studio/Business × 1/3/6-month
# prepay) needs nine, so this becomes a set when that lands.
NEXT_PUBLIC_PADDLE_PRICE_ID=
# `sandbox` makes the frontend call Paddle.Environment.set('sandbox') before
# Paddle.Initialize(). Anything else (including unset) = live, Paddle.js's own
# default. Switching to live is this one value, not a code edit.
NEXT_PUBLIC_PADDLE_ENVIRONMENT=
# Lemon Squeezy's plain hosted-checkout link, e.g.
# https://<store>.lemonsqueezy.com/checkout/buy/<variant_id>
NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=
# PostHog project key + reverse proxy setup. Public values, safe in the
# browser bundle. Leave any of the three unset to keep analytics disabled
# entirely — see env.ts's getPostHogConfig.
# HOST is your own domain, CNAME'd to PostHog's managed reverse proxy (set up
# under PostHog > Settings > Reverse proxy) — not eu.i.posthog.com/us.i.posthog.com
# directly, which is what ad blockers match against. UI_HOST is PostHog's own
# app (https://eu.posthog.com or https://us.posthog.com, matching your
# project's region) — required once HOST is a proxy, since the SDK can no
# longer infer where the dashboard lives from HOST alone (toolbar/session-replay links).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_UI_HOST=
